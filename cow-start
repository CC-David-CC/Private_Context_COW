#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
data=${1:-"$HOME/ContextCOW-data"}
if [ ! -x "$data/venv/bin/python" ] || [ ! -f "$data/server/server.json" ]; then
  echo "Run $root/cow-setup first." >&2
  exit 1
fi
exec "$data/venv/bin/python" "$root/tools/cow_server.py" "$data/server"
