From fdb4a0553f6ecb00450f04cc8da5b2b38dd9146d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E8=A8=B1=E5=85=83=E8=B1=AA?=
 <146086744+edenfunf@users.noreply.github.com>
Date: Wed, 7 Oct 2026 02:45:36 +0800
Subject: [PATCH] CUDA: fix OUT_PROD leading dimensions for size-1 dimensions

cuBLAS requires the leading dimension of each operand to be at least the
number of rows of the stored matrix. The ggml stride of a size-1
dimension is unused and can be smaller than that: ggml_transpose of a
[1, n] tensor yields a [n, 1] tensor with nb[1] == sizeof(float), which
ggml_is_transposed cannot distinguish from a non-transposed tensor. The
MUL_MAT backward pass produces exactly this tensor for the src1 gradient
when the output has a single row, so cublasSgemm fails with
CUBLAS_STATUS_INVALID_VALUE (test-backend-ops grad -o MUL_MAT).

Clamp lda and ldb to the number of rows of the stored matrices and add
OUT_PROD test cases with a transposed b and with a [m, 1] view of a
[1, m] tensor as a, both of which fail without the fix.
---
 ggml/src/ggml-cuda/out-prod.cu | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-cuda/out-prod.cu b/ggml/src/ggml-cuda/out-prod.cu
index c46e0455d..e75dba849 100644
--- a/ggml/src/ggml-cuda/out-prod.cu
+++ b/ggml/src/ggml-cuda/out-prod.cu
@@ -1,5 +1,6 @@
 #include "out-prod.cuh"
 
+#include <algorithm>
 #include <cstdint>
 
 static __global__ void k_compute_out_prod_ptrs(
@@ -54,13 +55,16 @@ void ggml_cuda_out_prod(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const float alpha = 1.0f;
     const float beta = 0.0f;
 
-    const int64_t lda = nb01 / sizeof(float);
+    // cuBLAS requires the leading dimensions to be at least the number of rows of the stored matrices.
+    // The ggml stride of a size-1 dimension is unused and can be smaller than that,
+    // e.g. ggml_transpose of a [1, n] tensor yields a [n, 1] tensor with nb[1] == sizeof(float).
+    const int64_t lda = std::max<int64_t>(nb01 / sizeof(float), ne00);
     const int64_t ldc = nb1  / sizeof(float);
 
     const bool src1_T = ggml_is_transposed(src1);
     const cublasOperation_t src1_cublas_op =  src1_T ? CUBLAS_OP_N : CUBLAS_OP_T;
-    const int64_t           ldb            = (src1_T ?        nb10 :        nb11) /  sizeof(float);
-    GGML_ASSERT(                             (src1_T ?        nb11 :        nb10) == sizeof(float));
+    const int64_t           ldb            = std::max<int64_t>((src1_T ? nb10 : nb11) / sizeof(float), src1_T ? ne11 : ne10);
+    GGML_ASSERT(                                               (src1_T ? nb11 : nb10) == sizeof(float));
 
     // data strides in dimensions 2/3
     const size_t s02 = nb02 / sizeof(float);
-- 
